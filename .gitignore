.claude

# macOS finder metadata
.DS_Store

# The per-project flow seam (.rdr/env.md, .rdr/resources.md, repo-local marker).
# Created by stages/00-bootstrap.md in the project that runs the flow; never
# versioned. See stages/README.md.
.rdr/

# Built binaries (rdr-init builds the projector here). bin/rdr-next is a
# tracked script beside them (as are rdr-gate and rdr-leg-commit), so the
# ignore is on the entries, not the dir.
bin/*
!bin/rdr-next
!bin/rdr-gate
!bin/rdr-leg-commit
!bin/rdr-leg-budget
!bin/rdr-leg-test
!bin/rdr-leg-read
!bin/rdr-leg-mark
!bin/rdr-leg-guard
