#!/bin/sh
# rdr-leg-commit — a Phase 2 leg's ONLY commit command: commit, then ask the budget.
#
# The `budget` rows of rdr-launch.toml bound a leg by what the world shows —
# commits since the leg's start SHA, minutes since its start epoch, the last
# suite exit — but "ask after every commit" was a rule the leg had to
# remember at its busiest moment, and one run's legs never asked (0 asks,
# 965K context, an auto-compaction mid-leg). Folding the ask into the
# commit makes it unskippable: git and the clock are read here, the caps
# are the tag domains in the model, and the leg only reports the suite.
#
#   rdr-leg-commit --start <sha> --since <epoch> --suite-green <true|false> [-m <subject>] [-C <dir>]
#
# Commits the whole tree (`git add -A`) under <subject>; a red tree
# (`--suite-green false`) gets a ` [wip]` suffix if the subject lacks one,
# so a partial leg's successor starts from git, never from a diff. A suffix,
# not a prefix: a consumer's commit-msg hook may enforce `type(scope): …`,
# and `wip: feat(x): …` fails it (seen in a dry-run). A clean tree commits
# nothing and still asks — a suite run with nothing new is an ask too. A commit the hook or git refuses prints their output and exits
# with their code; nothing is asked, since nothing moved. Then:
#   committed <sha>  <subject>   | nothing to commit
#   commits: N (<bucket>)
#   elapsed: M min (<bucket>)
#   next: continue | return-green | return-partial     (rdr-gate budget)
#   why: <the row's line>
# The buckets are read from `[tags.commits]` / `[tags.elapsed]` in the
# model, so a cap moved there moves here with no edit.

here=$(dirname "$0")
H="${RDR_HOME:-$here/..}"
M="$H/models/rdr-launch.toml"

usage() {
  [ $# -gt 0 ] && echo "rdr-leg-commit: $*" >&2
  echo "usage: rdr-leg-commit --start <sha> --since <epoch> --suite-green <true|false> [-m <subject>] [-C <dir>]" >&2
  exit 2
}

start= since= green= msg= C=
while [ $# -gt 0 ]; do
  case $1 in
    --start)       start=$2; shift 2 ;;
    --since)       since=$2; shift 2 ;;
    --suite-green) green=$2; shift 2 ;;
    -m)            msg=$2;   shift 2 ;;
    -C)            C=$2;     shift 2 ;;
    *) usage "unexpected '$1'" ;;
  esac
done
[ -n "$start" ] || usage "--start <sha> is the leg's start SHA from the brief"
case $since in ''|*[!0-9]*) usage "--since <epoch> is the leg's start, in epoch seconds" ;; esac
case $green in true|false) ;; *) usage "--suite-green <true|false> is the last suite exit — run it, then say" ;; esac
[ -f "$M" ] || { echo "stopped:no-routing-model — $M" >&2; exit 2; }

g() { if [ -n "$C" ]; then git -C "$C" "$@"; else git "$@"; fi; }

if [ -n "$(g status --porcelain)" ]; then
  [ -n "$msg" ] || usage "the tree is dirty: -m <subject> names the commit"
  [ "$green" = false ] && case $msg in *"[wip]"*) ;; *) msg="$msg [wip]" ;; esac
  g add -A || exit $?
  g commit -q -m "$msg" || exit $?      # a hook's refusal is printed by git; nothing moved
  echo "committed $(g rev-parse --short HEAD)  $msg"
else
  echo "nothing to commit"
fi

n=$(g rev-list --count "$start..HEAD") || exit 2
mins=$(( ($(date -u +%s) - since) / 60 ))

# bucket N over the tag's declared domain: `A-B` ranges and an open `A+`.
domain_of() { sed -n "/^\[tags\.$1\]/,/^\[/p" "$M" | sed -n 's/^domain *= *\[\(.*\)\]/\1/p' | tr -d '" ' | tr ',' ' '; }
bucket() {
  v=$1; shift
  for d in "$@"; do
    case $d in
      *+)  [ "$v" -ge "${d%+}" ] && { echo "$d"; return; } ;;
      *-*) [ "$v" -ge "${d%-*}" ] && [ "$v" -le "${d#*-}" ] && { echo "$d"; return; } ;;
    esac
  done
  echo "stopped:no-bucket — $v is outside the declared domain ($*)" >&2; exit 2
}
cb=$(bucket "$n" $(domain_of commits)) || exit 2
eb=$(bucket "$mins" $(domain_of elapsed)) || exit 2
echo "commits: $n ($cb)"
echo "elapsed: $mins min ($eb)"
exec "$here/rdr-gate" budget --tag "commits=$cb" --tag "elapsed=$eb" --tag "suite_green=$green"
