#!/bin/sh
# rdr-leg-mark — declare that a leg is working in a worktree, and in which role, so a guard and the helpers can tell a leg from its parent.
#
# The leg's brief names rdr-leg-read / rdr-leg-test / rdr-leg-commit as its
# only read, test and commit commands; the commands enforce nothing about
# the raw `cat`, `go test` and `git commit` a leg can still type. A harness
# hook can refuse those — but only if it knows the call comes from a leg,
# and a hook sees a command and a cwd, never a role. This is the role: a
# marker keyed by the worktree's real path, under /tmp so it is never in
# the tree (`rdr-leg-commit` stages everything).
#
#   rdr-leg-mark [--role implementer|test-author] <worktree>   # the leg's first call, after the isolation gate
#   rdr-leg-mark --clear <worktree>                            # the leg's last call, before its packet
#   rdr-leg-mark --query <dir>          # exit 0 iff <dir> (or the worktree containing it) is marked
#   rdr-leg-mark --role-of <dir>        # print the role; exit 1 if unmarked
#
# The role is the marker's second line, `implementer` unless said. A
# Phase 1 test author marks `--role test-author`: the helpers then run and
# commit THERE and are counted, but ask no budget — a red confirmation is
# not budget-bounded, and an elapsed refusal would strand it with no
# successor. One run's Phase 1 ran `go test` raw 40 times, committed with
# plain `git commit`, and never marked, so the guard was inert for the one
# leg whose red is the gate's evidence.
#
# The reference guard is bin/rdr-leg-guard; a consumer installs it as a
# PreToolUse hook (or not — the marker is inert without one).

usage() {
  [ $# -gt 0 ] && echo "rdr-leg-mark: $*" >&2
  echo "usage: rdr-leg-mark [--role implementer|test-author | --clear | --query | --role-of] <dir>" >&2
  exit 2
}

mode=mark role=implementer dir=
while [ $# -gt 0 ]; do
  case $1 in
    --clear)   mode=clear; shift ;;
    --query)   mode=query; shift ;;
    --role-of) mode=roleof; shift ;;
    --role)    role=$2; shift 2 ;;
    -*)        usage "unknown option '$1'" ;;
    *)         [ -z "$dir" ] || usage "one directory"; dir=$1; shift ;;
  esac
done
[ -n "$dir" ] || usage "one directory"
case $role in implementer|test-author) ;; *) usage "--role is implementer or test-author, got '$role'" ;; esac
[ -d "$dir" ] || { echo "rdr-leg-mark: no such directory: $dir" >&2; exit 2; }
top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || top=$dir
top=$(cd "$top" && pwd -P)
key=$(printf '%s' "$top" | cksum | cut -d' ' -f1)
marker="${TMPDIR:-/tmp}/rdr-leg/$key"

case $mode in
  mark)   mkdir -p "${TMPDIR:-/tmp}/rdr-leg" && printf '%s\n%s\n' "$top" "$role" > "$marker" && echo "marked $top ($role)" ;;
  clear)  rm -f "$marker" && echo "cleared $top" ;;
  query)  [ -f "$marker" ] ;;
  roleof) [ -f "$marker" ] || exit 1; r=$(sed -n '2p' "$marker"); echo "${r:-implementer}" ;;
esac
