#!/bin/sh
# rdr-leg-budget — the budget ask itself: git and the clock, bucketed, resolved.
#
# The `budget` rows of rdr-launch.toml bound a Phase 2 (or 3c) leg by what
# the world shows — commits since the leg's start SHA, minutes since its
# start epoch, the last suite exit. This reads the first two and asks the
# row; `rdr-leg-commit` and `rdr-leg-test` both end here, so the ask is the
# same whichever action the leg just took. The leg only reports the suite.
#
#   rdr-leg-budget -C <worktree> --start <sha> --since <epoch> --suite-green <true|false>
#
# In a worktree marked `--role test-author` (rdr-leg-mark) nothing is
# asked: it prints `budget: not asked` and exits 0, since a Phase 1 red
# confirmation is not budget-bounded. Every other role asks the row.
#
#   commits: N (<bucket>)
#   elapsed: M min (<bucket>)
#   next: continue | return-green | return-partial     (rdr-gate budget)
#   why: <the row's line>
# The buckets are read from `[tags.commits]` / `[tags.elapsed]` in the
# model, so a cap moved there moves here with no edit.

here=$(dirname "$0")
H="${RDR_HOME:-$here/..}"
M="$H/models/rdr-launch.toml"

usage() {
  [ $# -gt 0 ] && echo "rdr-leg-budget: $*" >&2
  echo "usage: rdr-leg-budget -C <worktree> --start <sha> --since <epoch> --suite-green <true|false>" >&2
  exit 2
}

start= since= green= C=
while [ $# -gt 0 ]; do
  case $1 in
    --start)       start=$2; shift 2 ;;
    --since)       since=$2; shift 2 ;;
    --suite-green) green=$2; shift 2 ;;
    -C)            C=$2;     shift 2 ;;
    *) usage "unexpected '$1'" ;;
  esac
done
[ -n "$C" ] || usage "-C <dir> is required: the leg's worktree root, so a run or a commit can never land in the session's cwd (one leg tested main and read a plausible green)"
[ -d "$C" ] || { echo "rdr-leg-budget: no such directory: $C" >&2; exit 2; }
top=$(git -C "$C" rev-parse --show-toplevel 2>/dev/null) || { echo "rdr-leg-budget: $C is not inside a git checkout" >&2; exit 2; }
[ "$(cd "$top" && pwd -P)" = "$(cd "$C" && pwd -P)" ] || { echo "rdr-leg-budget: -C must name the checkout root, got $C (root: $top)" >&2; exit 2; }
if [ "$(sh "$here/rdr-leg-mark" --role-of "$C" 2>/dev/null)" = test-author ]; then
  echo "budget: not asked — a test-author leg is not budget-bounded; the run or commit still landed in $C and is counted"
  exit 0
fi
[ -n "$start" ] || usage "--start <sha> is the leg's start SHA from the brief"
case $since in ''|*[!0-9]*) usage "--since <epoch> is the leg's start, in epoch seconds" ;; esac
case $green in true|false) ;; *) usage "--suite-green <true|false> is the full suite's exit — false until that last run" ;; esac
[ -f "$M" ] || { echo "stopped:no-routing-model — $M" >&2; exit 2; }

g() { if [ -n "$C" ]; then git -C "$C" "$@"; else git "$@"; fi; }

n=$(g rev-list --count "$start..HEAD") || exit 2
mins=$(( ($(date -u +%s) - since) / 60 ))

# bucket N over the tag's declared domain: `A-B` ranges and an open `A+`.
domain_of() { sed -n "/^\[tags\.$1\]/,/^\[/p" "$M" | sed -n 's/^domain *= *\[\(.*\)\]/\1/p' | tr -d '" ' | tr ',' ' '; }
bucket() {
  v=$1; shift
  for d in "$@"; do
    case $d in
      *+)  [ "$v" -ge "${d%+}" ] && { echo "$d"; return; } ;;
      *-*) [ "$v" -ge "${d%-*}" ] && [ "$v" -le "${d#*-}" ] && { echo "$d"; return; } ;;
    esac
  done
  echo "stopped:no-bucket — $v is outside the declared domain ($*)" >&2; exit 2
}
cb=$(bucket "$n" $(domain_of commits)) || exit 2
eb=$(bucket "$mins" $(domain_of elapsed)) || exit 2
echo "commits: $n ($cb)"
echo "elapsed: $mins min ($eb)"
exec "$here/rdr-gate" budget --tag "commits=$cb" --tag "elapsed=$eb" --tag "suite_green=$green"
