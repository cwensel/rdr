#!/bin/sh
# rdr-leg-guard — reference PreToolUse hook: in a marked worktree, the three raw commands a leg must not type are refused.
#
# NOT installed by the engine. A consumer that wants the leg's brief
# enforced rather than remembered wires this as a Claude Code
# `PreToolUse` hook on `Bash` (settings.json — the same slot retrofit's
# deny-primary-write.py uses); Codex has no hook, so its legs keep the
# prose. The hook reads the harness's JSON on stdin, takes the command
# and cwd, and asks `rdr-leg-mark --query` whether the cwd (or the
# worktree the command `cd`s into) is a marked leg. If it is, and the
# command runs a raw `cat` of a source or artifact file, a raw `go test`,
# or a raw `git commit`, it prints the harness's JSON deny (exit 0) naming
# the helper to use instead — the harness shows that reason to the leg and
# does not run the command. The deny is JSON on stdout, not an exit code:
# every consumer hook line ends `|| exit 0`, which swallows an exit 2.
# Anything else passes (no output, exit 0), and so does any failure to
# parse: a guard that cannot read its input must not block.
#
# Install (consumer, once; kata-flight-init offers it as `--guard`). The
# path is a LITERAL — a hook process carries none of the seam's variables:
#   {"hooks":{"PreToolUse":[{"matcher":"Bash","hooks":[{"type":"command",
#     "command":"sh \"/abs/path/to/rdr/bin/rdr-leg-guard\" || exit 0"}]}]}}

here=$(dirname "$0")
input=$(cat 2>/dev/null) || exit 0
command -v python3 >/dev/null 2>&1 || exit 0

parsed=$(printf '%s' "$input" | python3 -c '
import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    sys.exit(0)
if d.get("tool_name")!="Bash":
    sys.exit(0)
cmd=(d.get("tool_input") or {}).get("command","")
print(d.get("cwd",""))
print(cmd.replace("\n"," "))
') || exit 0
[ -n "$parsed" ] || exit 0
cwd=$(printf '%s\n' "$parsed" | sed -n '1p')
cmd=$(printf '%s\n' "$parsed" | sed -n '2p')

# the directory the command runs in: an explicit `cd <dir>` wins over the cwd
dir=$(printf '%s' "$cmd" | sed -n 's/^[[:space:]]*cd[[:space:]]\{1,\}\([^;&| ]*\).*/\1/p' | head -1)
[ -n "$dir" ] || dir=$cwd
[ -d "$dir" ] || exit 0
sh "$here/rdr-leg-mark" --query "$dir" || exit 0

refuse() {
  reason="rdr-leg-guard: a leg does not run '$1' — use $2"
  echo "$reason" >&2
  printf '%s' "$reason" | python3 -c 'import json,sys; print(json.dumps({"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":sys.stdin.read()}}))'
  exit 0
}
case " $cmd " in
  *" rdr-leg-test "*|*" rdr-leg-commit "*|*" rdr-leg-read "*) exit 0 ;;
esac
printf '%s' "$cmd" | grep -Eq '(^|[;&| ])cat[[:space:]]+[^>|;&][^|;&]*\.(go|md)([[:space:]]|$)' && refuse "cat <file>" "rdr-leg-read <path> [--symbol S | --range A-B]"
printf '%s' "$cmd" | grep -Eq '(^|[;&| ])go[[:space:]]+test([[:space:]]|$)' && refuse "go test" "rdr-leg-test -C <worktree> … -- go test …"
printf '%s' "$cmd" | grep -Eq '(^|[;&| ])git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[[:space:]]+commit([[:space:]]|$)' && refuse "git commit" "rdr-leg-commit -C <worktree> … -m …"
exit 0
