# RDR seam marker (TEMPLATE). /rdr-init (rdr/stages/00-bootstrap.md) copies + fills it.
# Two scopes — nearest wins (see rdr/stages/README.md *Where the seam lives*):
#   repo-local (default): $PROJECT/.rdr/workspace  — anchor paths on $PROJECT
#   workspace (--workspace): $WS/.rdr-workspace    — anchor paths on $WS (shared by siblings)
# Per-machine working config: untracked at install, versioned only here as the template.
#
# Consume it (worktree-invariant; the canonical resolver is rdr-common §seam-bind):
#   GC=$(git rev-parse --git-common-dir) && GC=$(cd "$GC" && pwd -P)
#   PROJECT=$(dirname "$GC"); WS=$(dirname "$PROJECT")
#   TOPLEVEL=$(git rev-parse --show-toplevel) || exit 1
#   export PROJECT WS TOPLEVEL
#   if   [ -f "$PROJECT/.rdr/workspace" ]; then . "$PROJECT/.rdr/workspace"
#   elif [ -f "$WS/.rdr-workspace" ];      then . "$WS/.rdr-workspace"; fi
# git-common-dir resolves the main repo's .git even from a worktree, so both anchors
# resolve from anywhere; sourcing the nearest marker binds every path below.

# $PROJECT and $WS are exported by the resolver above. A repo-local marker uses
# $PROJECT; a workspace marker uses $WS. Guard on whichever this marker anchors on:
: "${WS:?source this file via the canonical resolver so \$WS / \$PROJECT are set}"

# --- self-identification (FILL: keep the arm matching this marker's scope) ---
# A set-check proves the RESOLVER ran. It does not prove the resolver resolved
# THIS marker's project — every path below is derived from whatever $PROJECT
# happened to hold, so a marker sourced under a foreign project exports paths it
# invented, exit 0, no warning. A caller cannot tell that from a correct bind, and
# the consequence is silent: records read against another project's RDR_EVIDENCE
# make every lens probe read false, so a record with finished lenses reports as
# never lensed and the flow re-runs them over the evidence already on disk.
#
# So the marker states which project it describes and refuses to bind under any
# other. The assertion differs by scope, because the scopes claim different things:
#
#   repo-local  — describes ONE repo. EQUALITY on $PROJECT.
#   workspace   — anchors $WS and describes several sibling repos, so it is a
#                 MEMBERSHIP test: this repo must hold one of the seam paths.
#                 (doctor.sh check 1b implements the same rule independently.)
#
# Keep ONE arm and delete the other. RDR_PROJECT_ANCHOR is the absolute path this
# marker describes; it is written by /rdr-init and is not a contract var.

# repo-local arm — delete for a workspace marker:
RDR_PROJECT_ANCHOR="/abs/path/to/<your-project>"
[ "$PROJECT" = "$RDR_PROJECT_ANCHOR" ] || {
  echo "stopped:foreign-project marker=$RDR_PROJECT_ANCHOR/.rdr/workspace describes=$RDR_PROJECT_ANCHOR handed=$PROJECT" >&2
  return 1 2>/dev/null || exit 1
}
: "${TOPLEVEL:?source this file via the canonical resolver so \$TOPLEVEL is set}"

# workspace arm — delete for a repo-local marker; uncomment and set the anchor.
# This is only the FIRST half: a workspace marker makes two claims, and $WS
# equality is the cheap one (it catches a marker carried to another tree). The
# MEMBERSHIP half needs the contract vars, so it sits at the END of this file.
# RDR_PROJECT_ANCHOR="/abs/path/to/<your-workspace>"
# [ "$WS" = "$RDR_PROJECT_ANCHOR" ] || {
#   echo "stopped:foreign-workspace marker=$RDR_PROJECT_ANCHOR/.rdr-workspace describes=$RDR_PROJECT_ANCHOR handed=$WS" >&2
#   return 1 2>/dev/null || exit 1
# }

# --- per-consumer repo roots (FILL: keep the ones this workspace has) ---
# These name the sibling repos in YOUR workspace. They are conveniences for
# building the contract paths below — NOT load-bearing for the flow itself.
# Add/rename to match reality. Repo-local: $TOPLEVEL, the worktree being edited
# (equals $PROJECT outside one). Workspace: one per sibling, MYPROJECT_ROOT="$WS/myproject".
MYPROJECT_ROOT="$TOPLEVEL"

# === RDR engine contract — the FIVE vars the /rdr-* skills read ===============
# Everything below is required. The skills read ONLY these; they never recompute
# a repo root or assume a /rdr/cli path shape.

# RDR_HOME — the reusable RDR engine (stages/, prompts/, skills/, TEMPLATE.md).
#   /rdr-init fills this: the installed plugin dir ($CLAUDE_PLUGIN_ROOT) for a
#   plugin install, else the rdr repo cloned beside your repos ($WS/rdr).
RDR_HOME="$WS/rdr"

# RDR_RECORDS — THIS consumer's RDR-instances directory: where the NNNN-slug.md RDRs
#   and their per-RDR artifact subdirs live. The SINGLE source of truth for
#   "where do my RDRs live." /rdr-init writes it; resolve/claim read it.
#   Default .rdr/ consumer: "$MYPROJECT_ROOT/.rdr/rdrs"
#   Pinned/tracked consumer:  "$MYPROJECT_ROOT/rdr/cli"
RDR_RECORDS="$MYPROJECT_ROOT/rdr/cli"

# RDR_EVIDENCE — THIS consumer's evidence root: the base the lens/spike/reconcile
#   output ({EVIDENCE_DIR}, {SPIKE_DIR}) hangs under. Decoupled from RDR_RECORDS so
#   noisy evidence can stage anywhere — its own dir, a sibling repo, gitignored
#   scratch. Default: beside the records.
RDR_EVIDENCE="$RDR_RECORDS"

# RDR_ENV / RDR_RESOURCES — the path-map and evidence-index data files.
#   Default (gitignored .rdr/ seam at the project root; no rdr- prefix — .rdr/ scopes them):
#     RDR_ENV="$PROJECT/.rdr/env.md"
#     RDR_RESOURCES="$PROJECT/.rdr/resources.md"
#   Pinned seam (tracked sibling repo): point there, where rdr-env.md / rdr-resources.md
#   keep the prefix to stay self-describing.
# On $PROJECT, not the repo root: .rdr/ is untracked and exists only beside this marker.
RDR_ENV="$PROJECT/.rdr/env.md"
RDR_RESOURCES="$PROJECT/.rdr/resources.md"

# RDR_SOURCE_REPO — the checkout whose `path::Symbol` anchors the RDRs cite; the tree
#   `rdr --repo` greps (rdr-common §source-root). Usually this consumer's own
#   source root. Set it explicitly: under a workspace-scope marker the cwd may be
#   the records or evidence repo, so it cannot be derived. Omit only if the RDRs
#   cite no source anchors — then anchor checks report "not run", never clean.
RDR_SOURCE_REPO="$MYPROJECT_ROOT"

# RDR_USAGE_LOG — optional. What `rdr` was asked for and what it cost, one JSONL
#   line per invocation (tools/rdr/README.md §The usage log). It is the only thing
#   the projector ever writes, and it is off unless this says otherwise.
#     unset / "off"  no log — the default
#     "true"         log beside THIS marker: a repo-local marker puts it in the
#                    already self-ignoring $PROJECT/.rdr/; a workspace marker puts
#                    it at $WS/usage.jsonl, which is not inside any repo
#     <a path>       log there instead
#   Turn it on to measure whether the flow's reads are getting cheaper; the
#   numbers accumulate over ordinary use, with no dashboard and nothing to run.
# RDR_USAGE_LOG="true"

# RDR_INTRASTATE — where the `intrastate` binary is, when it is not on PATH. It
#   lints and resolves $RDR_HOME/models/*.toml (the navigator's routing as a
#   decision table). It lives in ANOTHER repo; /rdr-init installs it.
#     unset          look for `intrastate` on PATH (its own `make install`, or a
#                    `go install` with no GOBIN, puts it in ~/.local/bin)
#     <a path>       use this binary — set this when /rdr-init installed it beside
#                    `rdr` (GOBIN=$RDR_HOME/bin), or for a checkout's build
#   It is a DEPENDENCY, not an accelerator: the routing models are the authority
#   for which stage and which lens come next, so a skill that cannot reach it
#   stops rather than inferring an answer, and rdr-doctor 12 FAILs.
# RDR_INTRASTATE="$RDR_HOME/bin/intrastate"

# --- workspace membership (WORKSPACE SCOPE ONLY — delete for a repo-local marker) ---
# The second half of the workspace assertion, here because it reads the contract
# vars above. $WS matching says only that this marker belongs to this tree; it says
# nothing about whether THIS repo is part of the project the marker describes, and
# a sibling that merely lives under the same parent is exactly the caller that must
# not bind — it would inherit another project's RDR_RECORDS and land its RDRs there.
#
# Membership = this repo is the source root, or holds the records / evidence / seam
# data the marker names. A *_ROOT naming this repo is NOT membership: a marker lists
# sibling repos as conveniences, most with no RDR role. Only the four seam paths
# decide. doctor.sh check 1b implements this same rule from its own resolver, and
# must keep doing so: it may not use the seam to validate the seam.
# The ENGINE repo is a member by definition: $RDR_HOME is where the flow itself lives,
# it holds no records or evidence of its own, and doctor.sh 1b exempts it the same way
# (`"$PROJECT" != "$RDR_HOME"` gates that whole check). Without this arm a workspace
# marker refuses the very repo the skills are read from. The projector still refuses
# to bind RECORDS from there (stopped:engine-cwd): the engine is every consumer's, and
# a `cd $RDR_HOME && ./bin/rdr NNNN` once resolved another project's record.
# _mine=""
# [ "$PROJECT" = "$RDR_HOME" ] && _mine=1
# for _v in "$RDR_SOURCE_REPO" "$RDR_RECORDS" "$RDR_EVIDENCE" "$RDR_ENV"; do
#   case "$_v" in "$PROJECT"|"$PROJECT"/*) _mine=1;; esac
# done
# [ -n "$_mine" ] || {
#   echo "stopped:foreign-project marker=$RDR_PROJECT_ANCHOR/.rdr-workspace describes=$RDR_PROJECT_ANCHOR (records=$RDR_RECORDS) handed=$PROJECT — this repo holds none of its seam paths; run /rdr-init here to write a repo-local marker" >&2
#   unset _mine _v
#   return 1 2>/dev/null || exit 1
# }
# unset _mine _v

export WS MYPROJECT_ROOT RDR_HOME RDR_RECORDS RDR_EVIDENCE RDR_ENV RDR_RESOURCES RDR_SOURCE_REPO RDR_USAGE_LOG RDR_INTRASTATE
