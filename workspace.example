# RDR seam marker (TEMPLATE). /rdr-init (rdr/stages/00-bootstrap.md) copies + fills it.
# Two scopes — nearest wins (see rdr/stages/README.md *Where the seam lives*):
#   repo-local (default): $PROJECT/.rdr/workspace  — anchor paths on $PROJECT
#   workspace (--workspace): $WS/.rdr-workspace    — anchor paths on $WS (shared by siblings)
# Per-machine working config: untracked at install, versioned only here as the template.
#
# Consume it (worktree-invariant; the canonical resolver is rdr-common §seam-bind):
#   GC=$(git rev-parse --git-common-dir) && GC=$(cd "$GC" && pwd -P)
#   PROJECT=$(dirname "$GC"); WS=$(dirname "$PROJECT"); export PROJECT WS
#   if   [ -f "$PROJECT/.rdr/workspace" ]; then . "$PROJECT/.rdr/workspace"
#   elif [ -f "$WS/.rdr-workspace" ];      then . "$WS/.rdr-workspace"; fi
# git-common-dir resolves the main repo's .git even from a worktree, so both anchors
# resolve from anywhere; sourcing the nearest marker binds every path below.

# $PROJECT and $WS are exported by the resolver above. A repo-local marker uses
# $PROJECT; a workspace marker uses $WS. Guard on whichever this marker anchors on:
: "${WS:?source this file via the canonical resolver so \$WS / \$PROJECT are set}"

# --- per-consumer repo roots (FILL: keep the ones this workspace has) ---
# These name the sibling repos in YOUR workspace. They are conveniences for
# building the contract paths below — NOT load-bearing for the flow itself.
# Add/rename to match reality (e.g. MYPROJECT_ROOT="$WS/myproject").
MYPROJECT_ROOT="$WS/<your-project>"

# === RDR engine contract — the FIVE vars the /rdr-* skills read ===============
# Everything below is required. The skills read ONLY these; they never recompute
# a repo root or assume a /rdr/cli path shape.

# RDR_HOME — the reusable RDR engine (stages/, prompts/, skills/, TEMPLATE.md).
#   /rdr-init fills this: the installed plugin dir ($CLAUDE_PLUGIN_ROOT) for a
#   plugin install, else the rdr repo cloned beside your repos ($WS/rdr).
RDR_HOME="$WS/rdr"

# RDR_RECORDS — THIS consumer's RDR-instances directory: where the NNNN-slug.md RDRs
#   and their per-RDR artifact subdirs live. The SINGLE source of truth for
#   "where do my RDRs live." /rdr-init writes it; resolve/claim read it.
#   Default .rdr/ consumer: "$MYPROJECT_ROOT/.rdr/rdrs"
#   Pinned/tracked consumer:  "$MYPROJECT_ROOT/rdr/cli"
RDR_RECORDS="$MYPROJECT_ROOT/rdr/cli"

# RDR_EVIDENCE — THIS consumer's evidence root: the base the lens/spike/reconcile
#   output ({EVIDENCE_DIR}, {SPIKE_DIR}) hangs under. Decoupled from RDR_RECORDS so
#   noisy evidence can stage anywhere — its own dir, a sibling repo, gitignored
#   scratch. Default: beside the records.
RDR_EVIDENCE="$RDR_RECORDS"

# RDR_ENV / RDR_RESOURCES — the path-map and evidence-index data files.
#   Default (gitignored .rdr/ seam at the project root; no rdr- prefix — .rdr/ scopes them):
#     RDR_ENV="$MYPROJECT_ROOT/.rdr/env.md"
#     RDR_RESOURCES="$MYPROJECT_ROOT/.rdr/resources.md"
#   Pinned seam (tracked sibling repo): point there, where rdr-env.md / rdr-resources.md
#   keep the prefix to stay self-describing.
RDR_ENV="$MYPROJECT_ROOT/.rdr/env.md"
RDR_RESOURCES="$MYPROJECT_ROOT/.rdr/resources.md"

# RDR_SOURCE_REPO — the checkout whose `path::Symbol` anchors the RDRs cite; the tree
#   `rdr --repo` greps (rdr-common §source-root). Usually this consumer's own
#   source root. Set it explicitly: under a workspace-scope marker the cwd may be
#   the records or evidence repo, so it cannot be derived. Omit only if the RDRs
#   cite no source anchors — then anchor checks report "not run", never clean.
RDR_SOURCE_REPO="$MYPROJECT_ROOT"

# RDR_USAGE_LOG — optional. What `rdr` was asked for and what it cost, one JSONL
#   line per invocation (tools/rdr/README.md §The usage log). It is the only thing
#   the projector ever writes, and it is off unless this says otherwise.
#     unset / "off"  no log — the default
#     "true"         log beside THIS marker: a repo-local marker puts it in the
#                    already self-ignoring $PROJECT/.rdr/; a workspace marker puts
#                    it at $WS/usage.jsonl, which is not inside any repo
#     <a path>       log there instead
#   Turn it on to measure whether the flow's reads are getting cheaper; the
#   numbers accumulate over ordinary use, with no dashboard and nothing to run.
# RDR_USAGE_LOG="true"

# RDR_INTRASTATE — optional. The `intrastate` binary, which lints and resolves
#   $RDR_HOME/models/rdr-status.toml (the navigator's routing as a decision table).
#   It lives in ANOTHER repo, so it is not under $RDR_HOME/bin/ like `rdr` is, and
#   nothing here builds it.
#     unset          look for `intrastate` on PATH — its own `make install` puts it
#                    in ~/.local/bin — and if it is not there, skip the check
#     <a path>       use this binary, e.g. a checkout's "$WS/intrastate/bin/intrastate"
#   It is an ACCELERATOR, never a dependency: with no binary the skills read their
#   own prose and every stage still runs. Set it when the binary is built but not
#   installed, so rdr-doctor 12 can prove the routing model still covers every cell.
# RDR_INTRASTATE="$WS/intrastate/bin/intrastate"

export WS MYPROJECT_ROOT RDR_HOME RDR_RECORDS RDR_EVIDENCE RDR_ENV RDR_RESOURCES RDR_SOURCE_REPO RDR_USAGE_LOG RDR_INTRASTATE
