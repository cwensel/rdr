# .rdr-workspace — RDR/flow workspace path map (TEMPLATE).
#
# /rdr-init (rdr/stages/00-bootstrap.md) copies this to `.rdr-workspace` at the
# WORKSPACE PARENT (the dir holding the sibling repos, not itself a repo) and
# fills the blocks below for the machine. Per-machine working config: untracked
# at install, versioned only here as the template.
#
# Rationale — why it lives at the parent, why not an env var: see
# rdr/stages/README.md *Where the seam lives*.
#
# Consume it (worktree-invariant resolver):
#   WS=$(dirname "$(dirname "$(cd "$(git rev-parse --git-common-dir)" && pwd -P)")")
#   FLOW_ROOT="$WS/flow"; [ -f "$WS/.rdr-workspace" ] && . "$WS/.rdr-workspace"
# git-common-dir resolves the main repo's .git even from a worktree, so $WS is
# the workspace root from anywhere; sourcing this binds every path below.

# $WS is exported by the resolver above as the workspace root.
: "${WS:?source this file via the canonical resolver so \$WS is set}"

# --- per-consumer repo roots (FILL: keep the ones this workspace has) ---
# These name the sibling repos in YOUR workspace. They are conveniences for
# building the contract paths below — NOT load-bearing for the flow itself.
# Add/rename to match reality (e.g. MYPROJECT_ROOT="$WS/myproject").
MYPROJECT_ROOT="$WS/<your-project>"

# === RDR engine contract — the FIVE vars the /rdr-* skills read ===============
# Everything below is required. The skills read ONLY these; they never recompute
# a repo root or assume a /rdr/cli path shape.

# RDR_HOME — the reusable RDR engine (stages/, prompts/, skills/, TEMPLATE.md).
#   /rdr-init fills this: the installed plugin dir ($CLAUDE_PLUGIN_ROOT) for a
#   plugin install, else a sibling engine checkout ($WS/rdr).
RDR_HOME="$WS/rdr"

# RDR_RECORDS — THIS consumer's RDR-instances directory: where the NNNN-slug.md RDRs
#   and their per-RDR artifact subdirs live. The SINGLE source of truth for
#   "where do my RDRs live." /rdr-init writes it; resolve/claim read it.
#   Default .rdr/ consumer: "$MYPROJECT_ROOT/.rdr/rdrs"
#   Pinned/tracked consumer:  "$MYPROJECT_ROOT/rdr/cli"
RDR_RECORDS="$MYPROJECT_ROOT/rdr/cli"

# RDR_EVIDENCE — THIS consumer's evidence root: the base the lens/spike/reconcile
#   output ({EVIDENCE_DIR}, {SPIKE_DIR}) hangs under. Decoupled from RDR_RECORDS so
#   noisy evidence can stage anywhere — its own dir, a sibling repo, gitignored
#   scratch. Default: beside the records.
RDR_EVIDENCE="$RDR_RECORDS"

# RDR_ENV / RDR_RESOURCES — the path-map and evidence-index data files.
#   Default (gitignored .rdr/ seam at the project root; no rdr- prefix — .rdr/ scopes them):
#     RDR_ENV="$MYPROJECT_ROOT/.rdr/env.md"
#     RDR_RESOURCES="$MYPROJECT_ROOT/.rdr/resources.md"
#   Pinned seam (tracked sibling repo): point there, where rdr-env.md / rdr-resources.md
#   keep the prefix to stay self-describing.
RDR_ENV="$MYPROJECT_ROOT/.rdr/env.md"
RDR_RESOURCES="$MYPROJECT_ROOT/.rdr/resources.md"

export WS MYPROJECT_ROOT RDR_HOME RDR_RECORDS RDR_EVIDENCE RDR_ENV RDR_RESOURCES
