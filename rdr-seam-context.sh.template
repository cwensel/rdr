#!/bin/sh
# SessionStart hook — pre-resolve the RDR seam once per session so the /rdr-*
# skills can take rdr-common §seam-bind's fast path (literal paths, no per-run
# resolver round-trip). OPTIONAL ergonomics: the skills work without it (they run
# §seam-bind themselves); installing it just removes a per-call resolver.
#
# Install (offered by /rdr-init, never auto-installed): copy this to the
# consumer's `.claude/hooks/rdr-seam-context.sh` (chmod +x) and add a SessionStart
# entry to `.claude/settings.json` that runs it. Fail-quiet by design: if the
# workspace marker isn't reachable it emits nothing and the skills fall back.
# Claude Code-only by construction; other harnesses never see it.
GC=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
GC=$(cd "$GC" 2>/dev/null && pwd -P) || exit 0
PROJECT=$(dirname "$GC"); WS=$(dirname "$PROJECT"); export WS
# nearest marker wins: repo-local (inside .rdr/) overrides the shared workspace marker
if   [ -f "$PROJECT/.rdr/workspace" ]; then MARKER="$PROJECT/.rdr/workspace"
elif [ -f "$WS/.rdr-workspace" ];      then MARKER="$WS/.rdr-workspace"
else exit 0; fi
. "$MARKER" 2>/dev/null || exit 0
[ -n "$RDR_ENV" ] && [ -f "$RDR_ENV" ] || exit 0
# Emit only the five-var engine contract the skills read. (A consumer may add its
# own *_ROOT lines below if its sessions reference them; they are not load-bearing.)
cat <<EOF
RDR seam pre-resolved (SessionStart hook; rdr-common §seam-bind fast path applies —
substitute these literal paths, skip the resolver block):
RDR_HOME=$RDR_HOME
RDR_RECORDS=$RDR_RECORDS
RDR_EVIDENCE=$RDR_EVIDENCE
RDR_ENV=$RDR_ENV
RDR_RESOURCES=$RDR_RESOURCES
EOF
